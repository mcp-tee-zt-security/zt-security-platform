{
  "realm": "zt-stitch-contract",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "USER"
      },
      {
        "name": "STITCH_SYNC"
      }
    ]
  },
  "groups": [
    {
      "name": "employees"
    },
    {
      "name": "finance"
    }
  ],
  "clients": [
    {
      "clientId": "zt-stitch-human-demo",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "11111111-1111-1111-1111-111111111111",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "workspace_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "workspace_id",
            "claim.value": "88888888-8888-8888-8888-888888888801",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "stitch-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "zt-stitch-integration",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "actor_type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "actor_type",
            "claim.value": "HUMAN",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "stitch-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "zt-stitch-sync",
      "enabled": true,
      "publicClient": false,
      "secret": "local-stitch-sync-only",
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "11111111-1111-1111-1111-111111111111",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "workspace_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "workspace_id",
            "claim.value": "88888888-8888-8888-8888-888888888801",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "stitch-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "zt-stitch-integration",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "actor_type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "actor_type",
            "claim.value": "CONNECTOR",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "stitch-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa1",
      "username": "alice-demo",
      "enabled": true,
      "email": "alice-demo@example.invalid",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Synthetic",
      "credentials": [
        {
          "type": "password",
          "value": "local-stitch-human-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER"
      ],
      "groups": [
        "/employees",
        "/finance"
      ]
    },
    {
      "username": "service-account-zt-stitch-sync",
      "enabled": true,
      "serviceAccountClientId": "zt-stitch-sync",
      "realmRoles": [
        "STITCH_SYNC"
      ]
    }
  ]
}
