{
  "realm": "zt-mcp-demo",
  "enabled": true,
  "accessTokenLifespan": 300,
  "roles": {"realm": [{"name":"ADMIN"},{"name":"APPROVER"},{"name":"AUDITOR"},{"name":"REQUESTER"},{"name":"EXECUTOR"}]},
  "clients": [{
    "clientId": "zt-dashboard",
    "enabled": true,
    "protocol": "openid-connect",
    "publicClient": true,
    "standardFlowEnabled": true,
    "directAccessGrantsEnabled": false,
    "implicitFlowEnabled": false,
    "serviceAccountsEnabled": false,
    "fullScopeAllowed": true,
    "redirectUris": ["http://localhost:3000/*","http://127.0.0.1:3000/*","http://localhost:5173/*"],
    "webOrigins": ["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"],
    "attributes": {
      "pkce.code.challenge.method":"S256",
      "post.logout.redirect.uris":"http://localhost:3000/*##http://127.0.0.1:3000/*##http://localhost:5173/*"
    },
    "defaultClientScopes": ["basic","profile","email","roles","web-origins"],
    "protocolMappers": [
      {"name":"mcp-audience","protocol":"openid-connect","protocolMapper":"oidc-audience-mapper","config":{"included.custom.audience":"zt-mcp-gateway","access.token.claim":"true","id.token.claim":"false"}},
      {"name":"tenant","protocol":"openid-connect","protocolMapper":"oidc-hardcoded-claim-mapper","config":{"claim.name":"tenant_id","claim.value":"11111111-1111-1111-1111-111111111111","jsonType.label":"String","access.token.claim":"true","id.token.claim":"true"}},
      {"name":"workspace","protocol":"openid-connect","protocolMapper":"oidc-hardcoded-claim-mapper","config":{"claim.name":"workspace_id","claim.value":"88888888-8888-8888-8888-888888888801","jsonType.label":"String","access.token.claim":"true","id.token.claim":"true"}},
      {"name":"human","protocol":"openid-connect","protocolMapper":"oidc-hardcoded-claim-mapper","config":{"claim.name":"actor_type","claim.value":"HUMAN","jsonType.label":"String","access.token.claim":"true","id.token.claim":"true"}}
    ]
  }],
  "users": [
    {"username":"demo-admin","enabled":true,"firstName":"Demo","lastName":"Administrator","email":"demo-admin@example.test","emailVerified":true,"requiredActions":[],"credentials":[{"type":"password","value":"demo-admin","temporary":false}],"realmRoles":["ADMIN"]},
    {"username":"requester","enabled":true,"firstName":"Demo","lastName":"Requester","email":"requester@example.test","emailVerified":true,"requiredActions":[],"credentials":[{"type":"password","value":"demo-request","temporary":false}],"realmRoles":["REQUESTER"]},
    {"username":"executor","enabled":true,"firstName":"Demo","lastName":"Executor","email":"executor@example.test","emailVerified":true,"requiredActions":[],"credentials":[{"type":"password","value":"demo-execute","temporary":false}],"realmRoles":["EXECUTOR"]},
    {"username":"approver","enabled":true,"firstName":"Demo","lastName":"Approver","email":"approver@example.test","emailVerified":true,"requiredActions":[],"credentials":[{"type":"password","value":"demo-approve","temporary":false}],"realmRoles":["APPROVER"]},
    {"username":"viewer","enabled":true,"firstName":"Demo","lastName":"Viewer","email":"viewer@example.test","emailVerified":true,"requiredActions":[],"credentials":[{"type":"password","value":"demo-view","temporary":false}],"realmRoles":["AUDITOR"]}
  ]
}
