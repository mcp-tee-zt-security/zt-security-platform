<mxfile host="app.diagrams.net" version="24.7.17" type="device">
  <diagram id="architecture" name="01 - 시뮬레이터와 ZT 구조">
    <mxGraphModel dx="1840" dy="1320" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Stitch Client Simulator × ZT Control Plane" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#153653;" vertex="1" parent="1"><mxGeometry x="70" y="25" width="1660" height="48" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="현재 구현 기준  ·  클라이언트는 사용자 ACL과 자료를 제공하고, ZT는 AI 정책을 관리·집행합니다." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#526b80;" vertex="1" parent="1"><mxGeometry x="70" y="80" width="1650" height="32" as="geometry"/></mxCell>

        <mxCell id="sim" value="① 시뮬레이터 — 클라이언트 영역 (Stitch)" style="swimlane;html=1;horizontal=1;startSize=58;rounded=1;arcSize=10;fillColor=#e5f1fc;swimlaneFillColor=#f7fbff;strokeColor=#6d9ec8;strokeWidth=2;fontColor=#163e60;fontSize=22;fontStyle=1;align=left;spacingLeft=20;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="70" y="145" width="710" height="1050" as="geometry"/></mxCell>
        <mxCell id="sim-ui" value="&lt;b&gt;시뮬레이션 화면&lt;/b&gt;&lt;br&gt;localhost:8766&lt;br&gt;호출자·자료 선택 / 작업 결과 / 테스트 자격 증명" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3cce0;fontColor=#153653;fontSize=16;spacing=12;" vertex="1" parent="sim"><mxGeometry x="30" y="75" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="sim-idp" value="&lt;b&gt;테스트 IdP · Keycloak&lt;/b&gt;&lt;br&gt;Alice / Bob / Connector&lt;br&gt;서명된 OIDC JWT 발급" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3cce0;fontColor=#153653;fontSize=16;spacing=12;" vertex="1" parent="sim"><mxGeometry x="370" y="75" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="sim-controller" value="&lt;b&gt;데모 Controller&lt;/b&gt;&lt;br&gt;로그인·위임·요청 조정&lt;br&gt;자격 증명 및 세션 관리&lt;br&gt;사용자 요청과 AI 요청을 구분" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3cce0;fontColor=#153653;fontSize=16;spacing=12;" vertex="1" parent="sim"><mxGeometry x="30" y="220" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="sim-source" value="&lt;b&gt;가상 Stitch 서버&lt;/b&gt;&lt;br&gt;사용자·그룹·사용자 ACL&lt;br&gt;폴더·채널·파일·메시지·첨부파일&lt;br&gt;자료 및 사용자 권한 변경 feed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3cce0;fontColor=#153653;fontSize=16;spacing=12;" vertex="1" parent="sim"><mxGeometry x="370" y="220" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="sim-connector" value="&lt;b&gt;표준 Connector worker&lt;/b&gt;&lt;br&gt;자료·사용자 ACL 동기화 / 완료 체크포인트&lt;br&gt;삭제 전달·ACK 처리&lt;br&gt;&lt;font color=&quot;#526b80&quot;&gt;데모 Controller 프로세스에서 실행&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3cce0;fontColor=#153653;fontSize=15;spacing=12;" vertex="1" parent="sim"><mxGeometry x="370" y="450" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="sim-agent" value="&lt;b&gt;Stitchy · AI 클라이언트&lt;/b&gt;&lt;br&gt;전용 AI 자격 증명 + 사람의 위임&lt;br&gt;MCP tools/call 및 다운로드 요청&lt;br&gt;허용된 결과를 인용하여 답변" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3cce0;fontColor=#153653;fontSize=16;spacing=12;" vertex="1" parent="sim"><mxGeometry x="30" y="610" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="sim-gateway" value="&lt;b&gt;제한된 Gateway&lt;/b&gt;&lt;br&gt;읽기 / 검색 / MCP 요청을 ZT로 전달&lt;br&gt;AI 전용 Docker internal network&lt;br&gt;원본 서버·DB 직접 경로 제한" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf6ff;strokeColor=#6d9ec8;fontColor=#153653;fontSize=16;spacing=12;" vertex="1" parent="sim"><mxGeometry x="370" y="610" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="sim-memory" value="&lt;b&gt;AI 임시 저장소&lt;/b&gt;&lt;br&gt;승인받은 문서 / 보존 답변&lt;br&gt;60초 보존 및 삭제 요청 처리" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#b3cce0;fontColor=#153653;fontSize=16;spacing=12;" vertex="1" parent="sim"><mxGeometry x="30" y="805" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="sim-note" value="&lt;b&gt;클라이언트의 책임&lt;/b&gt;  사용자 ACL·자료 제공 / 자신의 AI 요청 / 수신 자료 삭제&lt;br&gt;AI 정책은 ZT에서 작성하며 클라이언트 동기화·Reset으로 덮어쓰지 않습니다." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#355b78;" vertex="1" parent="sim"><mxGeometry x="30" y="940" width="640" height="65" as="geometry"/></mxCell>

        <mxCell id="zt" value="② ZT — 공통 보안 플랫폼 / Control Plane" style="swimlane;html=1;horizontal=1;startSize=58;rounded=1;arcSize=10;fillColor=#def2eb;swimlaneFillColor=#f7fcfa;strokeColor=#68a894;strokeWidth=2;fontColor=#164f40;fontSize=22;fontStyle=1;align=left;spacingLeft=20;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="900" y="145" width="850" height="1050" as="geometry"/></mxCell>
        <mxCell id="zt-dashboard" value="&lt;b&gt;ZT 대시보드 · localhost:3000&lt;/b&gt;&lt;br&gt;Retrieval Access / Policy Studio / 클라이언트 호출 콘솔 / 감사 이력" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b6d7ca;fontColor=#164f40;fontSize=18;spacing=12;" vertex="1" parent="zt"><mxGeometry x="30" y="75" width="790" height="90" as="geometry"/></mxCell>
        <mxCell id="zt-registry" value="&lt;b&gt;클라이언트 연결 등록&lt;/b&gt;&lt;br&gt;Tenant / Workspace / Connection ID&lt;br&gt;검증된 Connector subject / Enabled&lt;br&gt;워크스페이스별 소스 연결 분리" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b6d7ca;fontColor=#164f40;fontSize=16;spacing=12;" vertex="1" parent="zt"><mxGeometry x="30" y="220" width="345" height="115" as="geometry"/></mxCell>
        <mxCell id="zt-policies" value="&lt;b&gt;ZT 중앙 AI 정책&lt;/b&gt;&lt;br&gt;Validate → DRAFT → Publish / ACTIVE&lt;br&gt;연결 / AI subject / 자료 subtree 범위&lt;br&gt;DENY 우선 / 매칭 ALLOW 없으면 기본 차단" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f1;strokeColor=#68a894;fontColor=#164f40;fontSize=16;spacing=12;" vertex="1" parent="zt"><mxGeometry x="440" y="220" width="380" height="115" as="geometry"/></mxCell>

        <mxCell id="zt-api" value="Authorization API (Spring Boot) · 공통 /v1/integrations/retrieval" style="swimlane;html=1;horizontal=1;startSize=42;rounded=1;fillColor=#e7efeb;swimlaneFillColor=#ffffff;strokeColor=#a6c5b7;fontColor=#245542;fontSize=16;fontStyle=1;align=left;spacingLeft=16;collapsible=0;container=1;" vertex="1" parent="zt"><mxGeometry x="30" y="395" width="790" height="440" as="geometry"/></mxCell>
        <mxCell id="zt-auth" value="&lt;b&gt;인증·신원·위임 검증&lt;/b&gt;&lt;br&gt;JWT / AI 서비스 계정&lt;br&gt;Connector 바인딩&lt;br&gt;AI 세션·만료·취소 확인" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8f6;strokeColor=#b6d7ca;fontColor=#164f40;fontSize=15;spacing=10;" vertex="1" parent="zt-api"><mxGeometry x="25" y="65" width="220" height="115" as="geometry"/></mxCell>
        <mxCell id="zt-check" value="&lt;b&gt;접근 판정&lt;/b&gt;&lt;br&gt;사용자 ACL 확인&lt;br&gt;AI는 활성 ZT 정책도 확인&lt;br&gt;기존 Java PolicyEvaluator" style="rhombus;whiteSpace=wrap;html=1;fillColor=#edf8f2;strokeColor=#68a894;fontColor=#164f40;fontSize=15;spacing=10;" vertex="1" parent="zt-api"><mxGeometry x="290" y="50" width="225" height="150" as="geometry"/></mxCell>
        <mxCell id="zt-retrieve" value="&lt;b&gt;권한 필터 조회 / RAG&lt;/b&gt;&lt;br&gt;읽기·검색·목록·다운로드&lt;br&gt;허용된 자료만 반환&lt;br&gt;캐시도 현재 권한 확인" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5f6ed;strokeColor=#68a894;fontColor=#164f40;fontSize=15;spacing=10;" vertex="1" parent="zt-api"><mxGeometry x="555" y="65" width="210" height="115" as="geometry"/></mxCell>
        <mxCell id="zt-ingest" value="&lt;b&gt;자료·사용자 ACL 동기화&lt;/b&gt;&lt;br&gt;등록된 Connector만 수용&lt;br&gt;소스 버전 / 사용자 그룹&lt;br&gt;완료 체크포인트 / 신선도" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8f6;strokeColor=#b6d7ca;fontColor=#164f40;fontSize=15;spacing=10;" vertex="1" parent="zt-api"><mxGeometry x="25" y="260" width="220" height="115" as="geometry"/></mxCell>
        <mxCell id="zt-block" value="&lt;b&gt;접근 차단&lt;/b&gt;&lt;br&gt;DENY / 허용 정책 없음&lt;br&gt;자료를 반환하지 않음&lt;br&gt;STEP_UP도 내용 반환 차단" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#d17c7c;fontColor=#8c3030;fontSize=15;spacing=10;" vertex="1" parent="zt-api"><mxGeometry x="290" y="260" width="225" height="115" as="geometry"/></mxCell>
        <mxCell id="zt-api-note" value="사람: 소스 사용자 ACL&lt;br&gt;AI: 사용자 ACL ∩ 현재 권한 ∩ 위임 ∩ 활성 ZT 정책" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#526b60;" vertex="1" parent="zt-api"><mxGeometry x="550" y="275" width="220" height="90" as="geometry"/></mxCell>

        <mxCell id="zt-data" value="&lt;b&gt;PostgreSQL · 자료 / 권한 / 검색&lt;/b&gt;&lt;br&gt;연결·사용자 ACL·부모 관계·자료&lt;br&gt;RAG index / 검색 결과 ID 캐시 / 위임 세션" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#b6d7ca;fontColor=#164f40;fontSize=15;spacing=12;" vertex="1" parent="zt"><mxGeometry x="30" y="885" width="360" height="110" as="geometry"/></mxCell>
