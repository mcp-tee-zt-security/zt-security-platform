  <diagram id="payroll-flow" name="02 - Payroll 조회와 정책 판정">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="flow-title" value="같은 Payroll 자료, 다른 호출자" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#153653;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="1450" height="50" as="geometry"/></mxCell>
        <mxCell id="flow-subtitle" value="전제: 사용자 ACL 동기화 완료 + AI 조회 ALLOW / Payroll·Finance DENY 정책 ACTIVE" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#526b80;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="1450" height="35" as="geometry"/></mxCell>
        <mxCell id="flow-sim" value="① 시뮬레이터 — 호출자" style="swimlane;html=1;horizontal=1;startSize=55;rounded=1;fillColor=#e5f1fc;swimlaneFillColor=#f7fbff;strokeColor=#6d9ec8;strokeWidth=2;fontColor=#163e60;fontSize=22;fontStyle=1;align=left;spacingLeft=20;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="380" height="740" as="geometry"/></mxCell>
        <mxCell id="flow-alice" value="&lt;b&gt;Alice · HUMAN&lt;/b&gt;&lt;br&gt;employees + finance&lt;br&gt;자신의 JWT로 Payroll 조회" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3cce0;fontColor=#153653;fontSize=17;spacing=12;" vertex="1" parent="flow-sim"><mxGeometry x="25" y="95" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="flow-bob" value="&lt;b&gt;Bob · HUMAN&lt;/b&gt;&lt;br&gt;employees&lt;br&gt;자신의 JWT로 Payroll 조회" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3cce0;fontColor=#153653;fontSize=17;spacing=12;" vertex="1" parent="flow-sim"><mxGeometry x="25" y="295" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="flow-ai" value="&lt;b&gt;Stitchy · AI_AGENT&lt;/b&gt;&lt;br&gt;자신의 AI credential&lt;br&gt;Alice가 발급한 위임 세션&lt;br&gt;MCP로 Payroll 조회" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3cce0;fontColor=#153653;fontSize=17;spacing=12;" vertex="1" parent="flow-sim"><mxGeometry x="25" y="495" width="330" height="135" as="geometry"/></mxCell>
        <mxCell id="flow-zt" value="② ZT — 인증·사용자 ACL·중앙 AI 정책" style="swimlane;html=1;horizontal=1;startSize=55;rounded=1;fillColor=#def2eb;swimlaneFillColor=#f7fcfa;strokeColor=#68a894;strokeWidth=2;fontColor=#164f40;fontSize=22;fontStyle=1;align=left;spacingLeft=20;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="500" y="150" width="1040" height="740" as="geometry"/></mxCell>
        <mxCell id="flow-alice-acl" value="&lt;b&gt;JWT 및 사용자 ACL 확인&lt;/b&gt;&lt;br&gt;Alice의 현재 finance 권한&lt;br&gt;Payroll 사용자 READ 허용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b6d7ca;fontColor=#164f40;fontSize=16;spacing=12;" vertex="1" parent="flow-zt"><mxGeometry x="30" y="95" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="flow-alice-result" value="&lt;b&gt;ALLOW&lt;/b&gt;&lt;br&gt;Payroll 자료 반환&lt;br&gt;사람의 조회는 사용자 ACL로 판정" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5f6ed;strokeColor=#68a894;fontColor=#245d3c;fontSize=17;spacing=12;" vertex="1" parent="flow-zt"><mxGeometry x="650" y="95" width="355" height="120" as="geometry"/></mxCell>
        <mxCell id="flow-bob-acl" value="&lt;b&gt;JWT 및 사용자 ACL 확인&lt;/b&gt;&lt;br&gt;Bob은 finance 권한 없음&lt;br&gt;Payroll 사용자 READ 미허용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b6d7ca;fontColor=#164f40;fontSize=16;spacing=12;" vertex="1" parent="flow-zt"><mxGeometry x="30" y="295" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="flow-bob-result" value="&lt;b&gt;DENY · 사용자 ACL&lt;/b&gt;&lt;br&gt;자료 반환 0건&lt;br&gt;AI 정책으로 사람 권한을 확장하지 않음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#d17c7c;fontColor=#8c3030;fontSize=17;spacing=12;" vertex="1" parent="flow-zt"><mxGeometry x="650" y="295" width="355" height="120" as="geometry"/></mxCell>
        <mxCell id="flow-ai-auth" value="&lt;b&gt;AI 신원 + 위임 + 사용자 ACL&lt;/b&gt;&lt;br&gt;위임은 Alice / 해당 AI에 바인딩&lt;br&gt;미만료·미취소 세션 확인&lt;br&gt;Alice의 Payroll 권한 확인" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b6d7ca;fontColor=#164f40;fontSize=15;spacing=12;" vertex="1" parent="flow-zt"><mxGeometry x="30" y="495" width="290" height="135" as="geometry"/></mxCell>
        <mxCell id="flow-ai-policy" value="&lt;b&gt;활성 ZT AI 정책 확인&lt;/b&gt;&lt;br&gt;deny_stitch_payroll&lt;br&gt;resource.ancestors에&lt;br&gt;sim-stitch-payroll 포함&lt;br&gt;하위 파일·첨부도 해당" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f1;strokeColor=#68a894;fontColor=#164f40;fontSize=15;spacing=12;" vertex="1" parent="flow-zt"><mxGeometry x="370" y="480" width="250" height="165" as="geometry"/></mxCell>
        <mxCell id="flow-ai-result" value="&lt;b&gt;DENY · ZT AI 정책&lt;/b&gt;&lt;br&gt;Alice는 볼 수 있지만 AI는 차단&lt;br&gt;자료 반환 0건&lt;br&gt;승인되지 않은 내용으로 답변하지 않음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#d17c7c;fontColor=#8c3030;fontSize=16;spacing=12;" vertex="1" parent="flow-zt"><mxGeometry x="650" y="495" width="355" height="135" as="geometry"/></mxCell>
        <mxCell id="flow-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3b82b9;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="flow-alice" target="flow-alice-acl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow-e2" value="사용자 ACL 통과" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#38845c;strokeWidth=2;endArrow=block;fontSize=14;fontColor=#245d3c;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="flow-alice-acl" target="flow-alice-result"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3b82b9;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="flow-bob" target="flow-bob-acl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow-e4" value="사용자 권한 없음" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c35b5b;strokeWidth=2;endArrow=block;fontSize=14;fontColor=#943d3d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="flow-bob-acl" target="flow-bob-result"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3b82b9;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="flow-ai" target="flow-ai-auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#68a894;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="flow-ai-auth" target="flow-ai-policy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow-e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c35b5b;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="flow-ai-policy" target="flow-ai-result"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow-rule" value="&lt;b&gt;최종 규칙&lt;/b&gt;&lt;br&gt;AI 접근 = 사용자 ACL ∩ 현재 사용자 권한 ∩ 위임 세션 ∩ 활성 ZT 정책&lt;br&gt;DENY 우선 / 매칭 ALLOW 없으면 자료 반환 차단 / 검색도 허용 자료만 후보에 포함" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f8;strokeColor=#c5d2dc;fontColor=#153653;fontSize=18;spacing=16;" vertex="1" parent="1"><mxGeometry x="60" y="935" width="1480" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
