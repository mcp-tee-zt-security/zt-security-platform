        <mxCell id="e-control-auth" value="사람의 조회 / 위임 생성" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3b82b9;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#245270;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.1;entryX=0;entryY=0.1;" edge="1" parent="1" source="sim-controller" target="zt-auth"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="378"/><mxPoint x="410" y="340"/><mxPoint x="860" y="340"/><mxPoint x="860" y="616"/></Array></mxGeometry></mxCell>
        <mxCell id="e-allow-return" value="ALLOW · 허용 자료 반환" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#38845c;strokeWidth=2;endArrow=block;fontSize=14;fontStyle=1;fontColor=#245d3c;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0.65;entryY=1;" edge="1" parent="1" source="zt-retrieve" target="sim-gateway"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1780" y="662"/><mxPoint x="1780" y="1230"/><mxPoint x="635" y="1230"/></Array><mxPoint x="0" y="15" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e-deny-return" value="DENY · 차단 결과만 반환" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c35b5b;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#943d3d;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;exitX=0.6;exitY=1;entryX=0.9;entryY=1;" edge="1" parent="1" source="zt-block" target="sim-gateway"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1355" y="1010"/><mxPoint x="710" y="1010"/></Array></mxGeometry></mxCell>
        <mxCell id="e-deletion-poll" value="삭제 이벤트 / ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c68a32;strokeWidth=2;dashed=1;endArrow=block;fontSize=12;fontColor=#875d1c;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;entryX=1;entryY=0.8;" edge="1" parent="1" source="zt-audit" target="sim-connector"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="1085"/><mxPoint x="880" y="687"/></Array></mxGeometry></mxCell>
        <mxCell id="e-deletion-source" value="수신자 삭제 계약" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c68a32;strokeWidth=2;dashed=1;endArrow=block;fontSize=12;fontColor=#875d1c;labelBackgroundColor=#ffffff;exitX=0.85;exitY=0;entryX=0.85;entryY=1;" edge="1" parent="1" source="sim-connector" target="sim-source"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-source-erase" value="AI 자료·답변 삭제 전달" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c68a32;strokeWidth=2;dashed=1;endArrow=block;fontSize=12;fontColor=#875d1c;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.45;entryX=1;entryY=0.15;" edge="1" parent="1" source="sim-source" target="sim-gateway"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="765" y="423"/><mxPoint x="765" y="774"/></Array></mxGeometry></mxCell>

        <mxCell id="legend" value="청색: 요청·동기화  /  녹색: 허용 자료  /  적색: 차단 결과  /  황색 점선: 삭제·ACK  /  회색: 내부 검증·저장 관계" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#526b80;" vertex="1" parent="1"><mxGeometry x="70" y="1270" width="1680" height="28" as="geometry"/></mxCell>
