{
  "info": {
    "name": "Stitch Integration v1 - OIDC ACL RAG Lifecycle",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Compatibility source/lifecycle requests. FIRST register the connector subject in ZT Retrieval Access and publish central AI ALLOW/DENY policies. Legacy aiAccess is ignored. Prefer Retrieval-Control-Plane-v2 collection for new clients. Send individually; versions must increase on re-sync. Source ACL/token/deletion requests modify local state."
  },
  "item": [
    {
      "name": "01 - Real local Keycloak tokens (synthetic identities)",
      "item": [
        {
          "name": "Human fixture token",
          "request": {
            "method": "POST",
            "url": "{{oidc_token_url}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "zt-stitch-human-demo"
                },
                {
                  "key": "username",
                  "value": "alice-demo"
                },
                {
                  "key": "password",
                  "value": "local-stitch-human-only"
                }
              ]
            },
            "description": "Local fixture only. Production human login uses the organization’s OIDC flow; these public demo credentials must not be deployed to a real identity realm."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.response.code===200)pm.environment.set('human_token',pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Connector service token",
          "request": {
            "method": "POST",
            "url": "{{oidc_token_url}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "zt-stitch-sync"
                },
                {
                  "key": "client_secret",
                  "value": "local-stitch-sync-only"
                }
              ]
            },
            "description": "Local fixture only. Production human login uses the organization’s OIDC flow; these public demo credentials must not be deployed to a real identity realm."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.response.code===200)pm.environment.set('connector_token',pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
