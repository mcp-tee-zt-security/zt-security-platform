            "url": "{{zt_base_url}}/v1/poc/stitch/management",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{admin_api_key}}"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              },
              {
                "key": "X-Workspace-Id",
                "value": "{{workspace_id}}"
              }
            ],
            "description": ""
