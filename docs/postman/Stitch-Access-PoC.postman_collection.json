    {
      "name": "03 - Settings / workspace history",
      "item": [
        {
          "name": "Allow AI Payroll (intentional demo change)",
          "request": {
            "method": "PUT",
            "url": "{{zt_base_url}}/v1/poc/stitch/areas/payroll/access",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{admin_api_key}}"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              },
              {
                "key": "X-Workspace-Id",
                "value": "{{workspace_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Changes AI access immediately. Re-send AI read to demonstrate change, then restore DENY. Existing responses cannot be recalled.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agentAccess\": \"ALLOW\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Restore AI Payroll DENY",
          "request": {
            "method": "PUT",
            "url": "{{zt_base_url}}/v1/poc/stitch/areas/payroll/access",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{admin_api_key}}"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              },
