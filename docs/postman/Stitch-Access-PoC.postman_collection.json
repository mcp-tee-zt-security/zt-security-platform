{
  "info": {
    "name": "Stitch AI Access - Synthetic PoC",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use existing ZT Local environment: zt_base_url, admin_api_key, tenant_id, workspace_id, client_id, client_secret. Register a service client first using main ZT collection. Send requests individually; settings requests change access. Synthetic data, server-side authorization, no real Stitch integration, no TEE/LLM/RAG. Requires ZT_STITCH_POC_ENABLED=true. No requests were run by Codex."
  },
  "item": [
    {
      "name": "01 - Administrator setup / human demo",
      "item": [
        {
          "name": "Initialize synthetic fixtures (idempotent)",
          "request": {
            "method": "POST",
            "url": "{{zt_base_url}}/v1/poc/stitch/setup",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{admin_api_key}}"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              },
              {
                "key": "X-Workspace-Id",
                "value": "{{workspace_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Existing settings are preserved; no production policies are published.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Administrator context",
          "request": {
            "method": "GET",
            "url": "{{zt_base_url}}/v1/poc/stitch/context",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{admin_api_key}}"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              },
              {
                "key": "X-Workspace-Id",
                "value": "{{workspace_id}}"
              }
            ],
            "description": ""
          }
        },
        {
