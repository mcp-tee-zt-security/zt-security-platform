{
  "title": "ZT Security Platform - SecOps Incident Response",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Open Incidents",
      "targets": [
        {
          "expr": "count(secops_incidents)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "API Error Rate During Incidents",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Pending Response Actions",
      "targets": [
        {
          "expr": "count(secops_response_actions{approval_status=\"PENDING\"})"
        }
      ]
    }
  ]
}