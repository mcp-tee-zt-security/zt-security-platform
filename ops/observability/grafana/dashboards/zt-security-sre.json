{
  "title": "ZT Security Platform - SRE",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Rate",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[5m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx Error Rate",
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count[5m])),0.001)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "P95 Latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum(rate(http_server_requests_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Available Replicas",
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{deployment=\"zt-security-platform\"}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Budget Burn",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[30m])) / clamp_min(sum(rate(http_server_requests_seconds_count[30m])),0.001)"
        }
      ]
    }
  ]
}