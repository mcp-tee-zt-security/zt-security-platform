# Local process configuration. Copy this file to .env and replace example values.
# Docker Compose passes only variables listed in its service environment sections.
# Values set directly in docker/docker-compose.yml override this example.

# Authorization API, database and observability
ZT_API_KEY=change-me
ZT_OIDC_ENABLED=false
ZT_OIDC_ISSUER_URI=http://localhost:8089/realms/zt
ZT_RATE_LIMIT=120
DB_URL=jdbc:postgresql://localhost:5432/zt
DB_USERNAME=zt
DB_PASSWORD=zt
REDIS_HOST=localhost
REDIS_PORT=6379
OTEL_METRICS_EXPORT_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Policy bundle signing
# Generate a key pair with python scripts/linux/generate-policy-signing-key.py
ZT_POLICY_SIGNING_PRIVATE_KEY_B64=
ZT_POLICY_PUBLIC_KEY_B64=
ZT_POLICY_SIGNING_KEY_ID=prod-policy-key-01

# Data-plane resilience
# ZT_BUNDLE_MAX_AGE_SECONDS is currently fixed at 60 in Docker Compose.
ZT_BUNDLE_MAX_AGE_SECONDS=60
ZT_FAIL_MODE=FAIL_CLOSED

# Attestation state (Rust data plane, supplied directly to the process)
# No cryptographic attestation verifier is installed in the current implementation.
# DOCUMENT_HASH reports document integrity only, not verified TEE identity.
# EXTERNAL_VERIFIED and REQUIRED remain UNVERIFIED and block readiness.
# These variables are not currently passed through by the default Docker Compose.
ZT_ATTESTATION_PROVIDER=NONE
ZT_ATTESTATION_MODE=DISABLED
ZT_NITRO_EXPECTED_PCR3=
ZT_NITRO_EXPECTED_PCR8=
ZT_ATTESTATION_NONCE=
ZT_ATTESTATION_KMS_KEY_ID=
ZT_NITRO_ATTESTATION_DOCUMENT_B64=
